Package: ceres
Type: Package
Title: An Interface to 'Ceres Solver' for Non-Linear Least Squares and Optimization
Version: 0.1.0
Date: 2026-10-21
Authors@R: c(
    person("Satyaprakash", "Nayak", role = c("aut", "cre"),
           email = "satyaprakash.nayak@gmail.com"),
    person("Google Inc.", role = "cph",
